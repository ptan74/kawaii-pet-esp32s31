# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico kawaii_pet"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Kawaii pet: TLS to caploralab.online with buffers in PSRAM, Wi-Fi AP+STA,
# setup web server, HTTP client and streaming sockets.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Keep internal RAM free for display/audio DMA: Wi-Fi/lwIP buffers and
# allocations above 4 KiB go to PSRAM, and 64 KiB stays reserved internally.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
